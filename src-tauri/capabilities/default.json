{
  "$schema": "https://raw.githubusercontent.com/nicegoodcode/tauri-2.0/main/crates/tauri/permissions/schemas/cap.schema.json",
  "identifier": "default",
  "description": "Default capability for the TTS Workshop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "shell:allow-open",
    "fs:default",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:scope-appdata-recursive",
    "fs:scope-applocaldata-recursive"
  ]
}
